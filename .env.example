# Copy to .env and fill in. This file is never read directly by the CLI
# (there's no dotenv loader wired in on purpose, to keep dependencies
# minimal) — export these into your shell, e.g. `export $(cat .env | xargs)`,
# or pass --github-token directly.

# A GitHub personal access token with NO scopes selected is sufficient —
# this tool only reads public data via GitHub's search + REST API.
# Create one at https://github.com/settings/tokens
# Unauthenticated requests work too, just at a much lower rate limit.
GITHUB_TOKEN=
